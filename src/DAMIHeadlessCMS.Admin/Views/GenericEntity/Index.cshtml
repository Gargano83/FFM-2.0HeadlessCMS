@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
    <h1 class="h3 mb-0">Dashboard</h1>
    <p class="text-muted mb-0">Riepilogo del backoffice.</p>
</div>

<div class="row row-cols-2 row-cols-md-4 g-3 mb-4">
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Entità scaffoldate</div>
                <div class="fs-3 fw-semibold">@Model.Counters.ScaffoldedEntities</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Pagine</div>
                <div class="fs-3 fw-semibold">@Model.Counters.Pages</div>
                <div class="text-muted small">@Model.Counters.PublishedPages pubblicate</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Voci di menu</div>
                <div class="fs-3 fw-semibold">@Model.Counters.MenuItems</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Utenti</div>
                <div class="fs-3 fw-semibold">@(Model.Counters.AdminUsers + Model.Counters.EditorUsers + Model.Counters.OperatorUsers)</div>
                <div class="text-muted small">
                    @Model.Counters.AdminUsers admin &middot; @Model.Counters.EditorUsers editor &middot; @Model.Counters.OperatorUsers operator
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3 d-flex justify-content-between align-items-center">
                <h2 class="h6 mb-0">Attività recente</h2>
                <span class="text-muted small">Pagine, Menu, Utenti</span>
            </div>
            <div class="card-body pt-0">
                @if (Model.RecentAuditEntries.Count == 0)
                {
                    <p class="text-muted small mb-0">Nessuna attività registrata.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0 cms-activity-feed">
                        @foreach (var entry in Model.RecentAuditEntries)
                        {
                            <li class="cms-activity-item">
                                <span class="cms-activity-dot @ActionDotClass(entry.Action)"></span>
                                <div class="cms-activity-body">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge @ActionBadgeClass(entry.Action)">@ActionLabel(entry.Action)</span>
                                        <span class="small text-truncate">@(entry.Summary ?? entry.EntityType)</span>
                                    </div>
                                    <div class="text-muted small">
                                        @(entry.UserEmail ?? "Sistema") &middot; @entry.TimestampUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white border-0 pt-3">
                <h2 class="h6 mb-0">Pagine recenti</h2>
            </div>
            <div class="card-body pt-0">
                @if (Model.RecentPages.Count == 0)
                {
                    <p class="text-muted small mb-0">Nessuna pagina creata.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var recentPage in Model.RecentPages)
                        {
                            <li class="d-flex justify-content-between align-items-center py-2 border-bottom">
                                <div>
                                    <a href="/dami/pages/@recentPage.Id/edit" class="text-decoration-none">@recentPage.Title</a>
                                    <div class="text-muted small">/@recentPage.Slug</div>
                                </div>
                                <div class="text-end">
                                    @if (recentPage.IsPublished)
                                    {
                                        <span class="badge bg-success-subtle text-success">Pubblicata</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary">Bozza</span>
                                    }
                                    <div class="text-muted small">@((recentPage.UpdatedAtUtc ?? recentPage.CreatedAtUtc).ToLocalTime().ToString("dd/MM/yyyy"))</div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@{
    var entityGroups = Model.Entities
        .GroupBy(e => string.IsNullOrWhiteSpace(e.GroupName) ? (string.IsNullOrWhiteSpace(e.SchemaName) ? "Generale" : e.SchemaName) : e.GroupName)
        .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
        .ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h2 class="h5 mb-0">Entità gestite</h2>
    @if (Model.Entities.Count > 0)
    {
        <div class="d-flex align-items-center gap-2">
            <div class="input-group input-group-sm" style="width:220px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search"></i></span>
                <input type="search" id="cmsEntitySearch" class="form-control border-start-0" placeholder="Filtra entità...">
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" id="cmsEntityToggleAll">
                Espandi tutti
            </button>
        </div>
    }
</div>

@if (Model.Entities.Count == 0)
{
    <div class="alert alert-info">Nessuna entità scaffoldata. Usa il wizard di scaffolding per iniziare.</div>
}
else
{
    <div id="cmsEntityGroups">
        @for (var groupIndex = 0; groupIndex < entityGroups.Count; groupIndex++)
        {
            var group = entityGroups[groupIndex];
            var collapseId = $"cmsEntityGroup{groupIndex}";
            <div class="card border-0 shadow-sm mb-3 cms-entity-group">
                <button type="button"
                        class="cms-entity-group-header btn w-100 text-start d-flex justify-content-between align-items-center"
                        data-bs-toggle="collapse" data-bs-target="#@collapseId"
                        aria-expanded="false" aria-controls="@collapseId">
                    <span class="d-flex align-items-center gap-2">
                        <i class="bi bi-chevron-right cms-entity-group-chevron"></i>
                        <span class="fw-semibold">@group.Key</span>
                        <span class="badge bg-secondary-subtle text-secondary">@group.Count()</span>
                    </span>
                </button>
                <div class="collapse" id="@collapseId">
                    <div class="card-body pt-0">
                        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
                            @foreach (var entity in group)
                            {
                                <div class="col cms-entity-card" data-entity-name="@($"{entity.DisplayName} {entity.QualifiedTableName}".ToLowerInvariant())">
                                    <div class="card h-100 shadow-sm border-0">
                                        <div class="card-body d-flex flex-column">
                                            <div class="d-flex align-items-center mb-3">
                                                <div class="rounded-3 bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-3"
                                                     style="width:48px;height:48px;">
                                                    <i class="bi bi-@(entity.Icon ?? "table") fs-4"></i>
                                                </div>
                                                <div>
                                                    <div class="fw-semibold text-dark">@entity.DisplayName</div>
                                                    <div class="text-muted small">@entity.QualifiedTableName</div>
                                                </div>
                                            </div>
                                            <div class="mt-auto d-flex gap-2">
                                                <a href="/dami/@entity.Id" class="btn btn-sm btn-primary flex-fill">
                                                    <i class="bi bi-table me-1"></i> Dati
                                                </a>
                                                <a href="/dami/@entity.Id/structure" class="btn btn-sm btn-outline-secondary flex-fill">
                                                    <i class="bi bi-diagram-3 me-1"></i> Struttura
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
        <p class="text-muted small mb-0 d-none" id="cmsEntityNoResults">Nessuna entità corrisponde alla ricerca.</p>
    </div>
}

<style>
    /* --- Attività recente: mini-timeline compatta con scroll interno --- */
    .cms-activity-feed {
        max-height: 420px;
        overflow-y: auto;
        position: relative;
        padding-left: .35rem;
    }

    .cms-activity-item {
        position: relative;
        display: flex;
        gap: .6rem;
        padding: .45rem 0 .45rem .75rem;
    }

    .cms-activity-item::before {
        content: "";
        position: absolute;
        left: 3px;
        top: 0;
        bottom: 0;
        width: 1px;
        background: #e9ecef;
    }

    .cms-activity-item:first-child::before { top: 50%; }
    .cms-activity-item:last-child::before { bottom: 50%; }

    .cms-activity-dot {
        position: absolute;
        left: 0;
        top: 1rem;
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #adb5bd;
    }

    .cms-activity-dot-success { background: #198754; }
    .cms-activity-dot-primary { background: #0d6efd; }
    .cms-activity-dot-danger { background: #dc3545; }
    .cms-activity-dot-secondary { background: #adb5bd; }

    .cms-activity-body { min-width: 0; flex: 1; }
    .cms-activity-body .text-truncate { max-width: 100%; display: inline-block; }

    /* --- Entità gestite: gruppi collassabili --- */
    .cms-entity-group-header {
        padding: .85rem 1.1rem;
        border-radius: .375rem;
    }

    .cms-entity-group-header:hover { background: rgba(0,0,0,.02); }

    .cms-entity-group-chevron { transition: transform .15s ease; }

    .cms-entity-group-header[aria-expanded="true"] .cms-entity-group-chevron {
        transform: rotate(90deg);
    }
</style>

@functions {
    private static string ActionBadgeClass(string action) => action switch
    {
        "Create" => "bg-success-subtle text-success",
        "Update" => "bg-primary-subtle text-primary",
        "Delete" => "bg-danger-subtle text-danger",
        _ => "bg-secondary-subtle text-secondary"
    };

    private static string ActionLabel(string action) => action switch
    {
        "Create" => "Creato",
        "Update" => "Modificato",
        "Delete" => "Eliminato",
        _ => action
    };

    private static string ActionDotClass(string action) => action switch
    {
        "Create" => "cms-activity-dot-success",
        "Update" => "cms-activity-dot-primary",
        "Delete" => "cms-activity-dot-danger",
        _ => "cms-activity-dot-secondary"
    };
}

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('cmsEntitySearch');
            const toggleAllBtn = document.getElementById('cmsEntityToggleAll');
            const groupsContainer = document.getElementById('cmsEntityGroups');
            if (!groupsContainer) return;

            const groups = Array.from(groupsContainer.querySelectorAll('.cms-entity-group'));
            const noResults = document.getElementById('cmsEntityNoResults');

            function collapseInstance(el) {
                return bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
            }

            function setGroupExpanded(group, expanded) {
                const collapseEl = group.querySelector('.collapse');
                if (!collapseEl) return;
                const instance = collapseInstance(collapseEl);
                expanded ? instance.show() : instance.hide();
            }

            // Filtro di ricerca: nasconde le card che non corrispondono, nasconde i
            // gruppi rimasti senza risultati ed espande automaticamente quelli con
            // corrispondenze (ripristinando lo stato normale quando il campo è vuoto).
            searchInput?.addEventListener('input', () => {
                const query = searchInput.value.trim().toLowerCase();
                let anyVisible = false;

                groups.forEach((group, index) => {
                    const cards = Array.from(group.querySelectorAll('.cms-entity-card'));
                    let groupHasMatch = false;

                    cards.forEach(card => {
                        const matches = query === '' || card.dataset.entityName.includes(query);
                        card.classList.toggle('d-none', !matches);
                        if (matches) groupHasMatch = true;
                    });

                    group.classList.toggle('d-none', !groupHasMatch);
                    if (groupHasMatch) anyVisible = true;

                    if (query !== '') {
                        setGroupExpanded(group, groupHasMatch);
                    } else {
                        setGroupExpanded(group, false);
                    }
                });

                noResults?.classList.toggle('d-none', anyVisible || query === '');
            });

            // Espandi/comprimi tutti i gruppi in un solo click.
            toggleAllBtn?.addEventListener('click', () => {
                const shouldExpand = toggleAllBtn.textContent.trim() === 'Espandi tutti';
                groups.forEach(group => setGroupExpanded(group, shouldExpand));
                toggleAllBtn.textContent = shouldExpand ? 'Comprimi tutti' : 'Espandi tutti';
            });
        })();
    </script>
}
