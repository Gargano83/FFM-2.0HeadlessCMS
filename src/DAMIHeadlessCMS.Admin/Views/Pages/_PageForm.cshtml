@model PageFormViewModel

<div class="row g-3 mb-4">
    <div class="col-12 col-md-6">
        <label class="form-label fw-medium" for="Title">Titolo <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="Title" name="Title" value="@Model.Title" required />
    </div>
    <div class="col-12 col-md-6">
        <label class="form-label fw-medium" for="Slug">Slug <span class="text-danger">*</span></label>
        <input type="text" class="form-control" id="Slug" name="Slug" value="@Model.Slug" placeholder="es. chi-siamo" required />
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label fw-medium" for="ParentId">Pagina genitore</label>
        <select class="form-select" id="ParentId" name="ParentId">
            <option value="">— Nessuna (pagina radice) —</option>
            @foreach (var option in Model.ParentOptions)
            {
                var isSelected = Model.ParentId == option.Id;
                <option value="@option.Id" selected="@isSelected">@option.Title</option>
            }
        </select>
    </div>
    <div class="col-12 col-md-4">
        <label class="form-label fw-medium" for="SortOrder">Ordine</label>
        <input type="number" class="form-control" id="SortOrder" name="SortOrder" value="@Model.SortOrder" />
    </div>
    <div class="col-12 col-md-4 d-flex align-items-end">
        <div class="form-check form-switch">
            <input type="checkbox" class="form-check-input" id="IsPublished" name="IsPublished" value="true" checked="@Model.IsPublished" />
            <label class="form-check-label" for="IsPublished">Pubblicata</label>
        </div>
    </div>
</div>

<hr class="my-4" />

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Contenuto a blocchi</h5>
    <div class="dropdown">
        <button class="btn btn-sm btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown">
            <i class="bi bi-plus-lg me-1"></i> Aggiungi blocco
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><button type="button" class="dropdown-item cms-add-block" data-type="html"><i class="bi bi-file-earmark-richtext me-2"></i>Testo/HTML</button></li>
            <li><button type="button" class="dropdown-item cms-add-block" data-type="entityList"><i class="bi bi-table me-2"></i>Lista entità</button></li>
            <li><button type="button" class="dropdown-item cms-add-block" data-type="component"><i class="bi bi-puzzle me-2"></i>Componente esterno</button></li>
        </ul>
    </div>
</div>

<div id="cmsBlocksContainer" class="d-flex flex-column gap-3 mb-3"></div>

<div id="cmsBlocksEmpty" class="alert alert-light border text-center text-muted d-none">
    Nessun blocco ancora. Usa "Aggiungi blocco" per iniziare a comporre il contenuto della pagina.
</div>

<input type="hidden" id="ContentJson" name="ContentJson" value="@Model.ContentJson" />

<div class="mt-4 d-flex gap-2">
    <button type="submit" class="btn btn-primary" id="cmsPageSubmit">
        <i class="bi bi-check-lg me-1"></i> Salva pagina
    </button>
    <a href="/dami/pages" class="btn btn-outline-secondary">Annulla</a>
</div>

<link href="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.2/dist/quill.js"></script>
<style>
    .ql-toolbar.ql-snow {
        display: flex;
        flex-wrap: wrap;
        row-gap: .35rem;
    }
</style>
<script>
    (function () {
        const container = document.getElementById('cmsBlocksContainer');
        const emptyState = document.getElementById('cmsBlocksEmpty');
        const contentJsonInput = document.getElementById('ContentJson');
        const availableEntities = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableEntities));

        const cmsQuillToolbarOptions = [
            [{ header: [1, 2, 3, false] }],
            ['bold', 'italic', 'underline', 'strike'],
            [{ color: [] }, { background: [] }],
            [{ script: 'sub' }, { script: 'super' }],
            [{ list: 'ordered' }, { list: 'bullet' }],
            [{ indent: '-1' }, { indent: '+1' }],
            [{ align: [] }],
            ['blockquote'],
            ['link', 'image'],
            ['clean']
        ];

        // Upload reale dell'immagine selezionata dal pulsante Quill: niente
        // base64 incorporato nell'HTML (gonfierebbe ContentJson e le
        // performance della pagina pubblica), il file va sul filesystem
        // dell'host tramite IFileStorageProvider e nell'HTML resta solo l'URL.
        function quillImageHandler() {
            const quill = this.quill;
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.addEventListener('change', async () => {
                const file = input.files[0];
                if (!file) return;

                const range = quill.getSelection(true);
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const formData = new FormData();
                formData.append('file', file);
                if (token) formData.append('__RequestVerificationToken', token);

                try {
                    const res = await fetch('/dami/pages/upload-image', { method: 'POST', body: formData });
                    if (!res.ok) {
                        const err = await res.json().catch(() => null);
                        alert(err?.error || 'Caricamento immagine non riuscito.');
                        return;
                    }
                    const data = await res.json();
                    quill.insertEmbed(range.index, 'image', data.url, 'user');
                    quill.setSelection(range.index + 1);
                } catch {
                    alert('Caricamento immagine non riuscito.');
                }
            });
            input.click();
        }

        let blocks = [];
        try {
            blocks = JSON.parse(contentJsonInput.value || '[]');
        } catch {
            blocks = [];
        }

        // Un blocco html con contenuto ma senza sourceMode esplicito (pagine salvate
        // prima dell'introduzione di questo flag, o mai toccate col toggle da allora)
        // NON deve mai finire dentro Quill in automatico al caricamento: se il markup
        // contiene tag che Quill non riconosce (es. <section>), verrebbe scartato in
        // silenzio, e un salvataggio successivo — anche senza toccare nulla — lo
        // sovrascriverebbe con la versione vuota. Di default: contenuto esistente →
        // sorgente (sicuro, mai processato da Quill senza un'azione esplicita
        // dell'utente); blocco nuovo/vuoto → editor visuale (nulla da perdere).
        blocks.forEach((block) => {
            if (block.type === 'html' && block.sourceMode === undefined) {
                block.sourceMode = !!(block.html && block.html.trim());
            }
        });

        const quillInstances = new Map();
        let blockSeq = 0;
        function uid() { return 'blk' + (blockSeq++); }

        function blockLabel(type) {
            return { html: 'Testo/HTML', entityList: 'Lista entità', component: 'Componente esterno' }[type] || type;
        }
        function blockIcon(type) {
        return { html: 'file-earmark-richtext', entityList: 'table', component: 'puzzle' }[type] || 'question';
        }

        function render() {
            container.innerHTML = '';
            emptyState.classList.toggle('d-none', blocks.length > 0);

            blocks.forEach((block) => {
                const clientId = block.__clientId || (block.__clientId = uid());
                const card = document.createElement('div');
                card.className = 'card border-0 shadow-sm cms-block-card';
                card.dataset.clientId = clientId;

                let bodyHtml = '';
                if (block.type === 'html') {
                    bodyHtml = `
                        <div class="cms-quill-editor" style="min-height:160px; ${block.sourceMode ? 'display:none;' : ''}"></div>
                        <textarea class="form-control font-monospace cms-html-source" rows="10"
                                  style="${block.sourceMode ? '' : 'display:none;'}"
                                  placeholder="&lt;section class=&quot;...&quot;&gt;...&lt;/section&gt;"></textarea>
                        <div class="form-text mt-1">
                        "HTML sorgente" per incollare markup personalizzato (es. classi Bootstrap
                        di un template esistente): l'editor visuale è pensato per la formattazione
                        tramite i pulsanti della toolbar, non per markup incollato a mano — se il
                        markup usa tag/classi che Quill non riconosce (es. &lt;section&gt;), passare
                        a "Editor visuale" può semplificarlo o perderlo: resta in sorgente e salva
                        da lì se ti serve il controllo esatto sul markup.
                        </div>`;
                } else if (block.type === 'entityList') {
                    const options = availableEntities.map(e =>
                        `<option value="${e.qualifiedName}" ${e.qualifiedName === block.entity ? 'selected' : ''}>${e.displayName}</option>`
                    ).join('');
                    bodyHtml = `
                        <div class="row g-2">
                        <div class="col-12 col-md-6">
                        <label class="form-label small">Entità da elencare</label>
                        <select class="form-select block-entity-select">
                        <option value="">— Seleziona —</option>
                        ${options}
                        </select>
                        </div>
                        <div class="col-12 col-md-4">
                        <label class="form-label small">Titolo sopra l'elenco (opzionale)</label>
                        <input type="text" class="form-control block-entity-title" value="${block.title ?? ''}" placeholder="es. Ultime notizie" />
                        </div>
                        <div class="col-12 col-md-2">
                        <label class="form-label small">Righe massime</label>
                        <input type="number" min="1" max="200" class="form-control block-entity-max-rows" value="${block.maxRows ?? 50}" />
                        </div>
                        </div>
                        <div class="form-text mt-2">
                        Mostra le colonne marcate "in elenco" per l'entità scelta (configurabile nel wizard di scaffolding → Struttura), risolvendo automaticamente anche le eventuali FK in etichetta leggibile.
                        </div>`;
                } else if (block.type === 'component') {
                    bodyHtml = `
                        <div class="row g-2">
                        <div class="col-12 col-md-4">
                        <label class="form-label small">Tag/nome componente</label>
                        <input type="text" class="form-control block-component-tag" value="${block.tag ?? ''}" placeholder="es. app-widget" />
                        </div>
                        <div class="col-12 col-md-8">
                        <label class="form-label small">Configurazione (JSON)</label>
                        <textarea class="form-control font-monospace block-component-config" rows="3">${JSON.stringify(block.config ?? {}, null, 2)}</textarea>
                        </div>
                        </div>`;
                }

                card.innerHTML = `
                    <div class="card-header bg-white d-flex justify-content-between align-items-center cms-block-handle" style="cursor:grab;">
                    <span><i class="bi bi-grip-vertical text-muted me-2"></i><i class="bi bi-${blockIcon(block.type)} me-2"></i>${blockLabel(block.type)}</span>
                    <span>
                    ${block.type === 'html' ? `<button type="button" class="btn btn-sm btn-outline-secondary me-2 cms-toggle-html-source"><i class="bi bi-code-slash"></i> ${block.sourceMode ? 'Editor visuale' : 'HTML sorgente'}</button>` : ''}
                    <button type="button" class="btn btn-sm btn-outline-danger cms-remove-block"><i class="bi bi-trash"></i></button>
                    </span>
                    </div>
                    <div class="card-body">${bodyHtml}</div>
                    `;

                container.appendChild(card);

                if (block.type === 'html') {
                    const quillContainer = card.querySelector('.cms-quill-editor');
                    const sourceTextarea = card.querySelector('.cms-html-source');
                    sourceTextarea.value = block.html ?? '';

                    const quill = new Quill(quillContainer, {
                        theme: 'snow',
                        modules: {
                            toolbar: {
                                container: cmsQuillToolbarOptions,
                                handlers: { image: quillImageHandler }
                            }
                        }
                    });
                    // Un blocco in modalità sorgente NON viene mai versato in Quill in
                    // automatico al caricamento: Quill riconcilia il DOM secondo i tag
                    // che conosce e scarterebbe silenziosamente markup non riconosciuto
                    // (es. <section>), svuotando l'editor a ogni riapertura della pagina
                    // pur restando il valore salvato corretto. Viene versato in Quill solo
                    // se e quando l'utente sceglie esplicitamente "Editor visuale".
                    if (!block.sourceMode) {
                        quill.root.innerHTML = block.html ?? '';
                    }
                    quillInstances.set(clientId, quill);

                    card.querySelector('.cms-toggle-html-source').addEventListener('click', (ev) => {
                        ev.stopPropagation();
                        if (block.sourceMode) {
                            quill.root.innerHTML = sourceTextarea.value;
                            block.html = sourceTextarea.value;
                            block.sourceMode = false;
                        } else {
                            sourceTextarea.value = quill.root.innerHTML;
                            block.html = quill.root.innerHTML;
                            block.sourceMode = true;
                        }
                        quillContainer.style.display = block.sourceMode ? 'none' : '';
                        sourceTextarea.style.display = block.sourceMode ? '' : 'none';
                        card.querySelector('.cms-toggle-html-source').innerHTML =
                            `<i class="bi bi-code-slash"></i> ${block.sourceMode ? 'Editor visuale' : 'HTML sorgente'}`;
                    });
                }

                card.querySelector('.cms-remove-block').addEventListener('click', () => {
                    commitAllBlocksFromDom();
                    blocks = blocks.filter(b => b.__clientId !== clientId);
                    quillInstances.delete(clientId);
                    render();
                });
            });

            new Sortable(container, {
                handle: '.cms-block-handle',
                animation: 150,
                onEnd: syncOrderFromDom
            });
        }

        function syncOrderFromDom() {
            const orderedIds = Array.from(container.children).map(c => c.dataset.clientId);
            blocks.sort((a, b) => orderedIds.indexOf(a.__clientId) - orderedIds.indexOf(b.__clientId));
        }

        // Riporta nel modello `blocks` quanto digitato/impostato nella card DOM di un
        // singolo blocco. Va richiamata prima di QUALSIASI re-render (aggiungi/rimuovi
        // blocco ricostruiscono tutte le card da `blocks`: senza questo commit, le
        // modifiche non ancora "salvate" negli altri blocchi andrebbero perse).
        // Ritorna un messaggio d'errore (o null) invece di allertare direttamente: solo
        // il salvataggio finale deve bloccare l'utente per un JSON non valido.
        function commitBlockFromCard(card, block) {
            if (block.type === 'html') {
                if (block.sourceMode) {
                    const textarea = card.querySelector('.cms-html-source');
                    if (textarea) block.html = textarea.value;
                } else {
                    const quill = quillInstances.get(block.__clientId);
                    if (quill) block.html = quill.root.innerHTML;
                }
            } else if (block.type === 'entityList') {
                block.entity = card.querySelector('.block-entity-select').value;
                block.title = card.querySelector('.block-entity-title').value.trim();
                const maxRows = parseInt(card.querySelector('.block-entity-max-rows').value, 10);
                block.maxRows = Number.isFinite(maxRows) && maxRows > 0 ? maxRows : 50;
            } else if (block.type === 'component') {
                block.tag = card.querySelector('.block-component-tag').value;
                const raw = card.querySelector('.block-component-config').value;
                try {
                    block.config = raw.trim() ? JSON.parse(raw) : {};
                } catch {
                    return `La configurazione del blocco "${block.tag || 'componente'}" non è un JSON valido.`;
                }
            }
            return null;
        }

        function commitAllBlocksFromDom({ strict = false } = {}) {
            let error = null;
            container.querySelectorAll('.cms-block-card').forEach(card => {
                const block = blocks.find(b => b.__clientId === card.dataset.clientId);
                if (!block) return;
                const blockError = commitBlockFromCard(card, block);
                if (blockError && strict && !error) error = blockError;
            });
            return error;
        }

        document.querySelectorAll('.cms-add-block').forEach(btn => {
            btn.addEventListener('click', () => {
                commitAllBlocksFromDom();
                const type = btn.dataset.type;
                const newBlock = { type, __clientId: uid() };
                if (type === 'entityList') { newBlock.entity = ''; newBlock.title = ''; newBlock.maxRows = 50; }
                if (type === 'component') { newBlock.tag = ''; newBlock.config = {}; }
                if (type === 'html') newBlock.html = '';
                blocks.push(newBlock);
                render();
            });
        });

        document.getElementById('cmsPageSubmit').addEventListener('click', (e) => {
            syncOrderFromDom();
            const error = commitAllBlocksFromDom({ strict: true });

            if (error) {
                e.preventDefault();
                alert(error);
                return;
            }

            const cleanBlocks = blocks.map(({ __clientId, ...rest }) => rest);
            contentJsonInput.value = JSON.stringify(cleanBlocks);
        });

        render();
    })();
</script>