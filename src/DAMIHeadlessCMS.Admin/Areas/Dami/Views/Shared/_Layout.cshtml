@inject DAMIHeadlessCMS.Data.CmsDbContext Db
@functions {
    bool IsActive(string path) => Context.Request.Path.Value?.StartsWith(path, StringComparison.OrdinalIgnoreCase) == true;
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DAMIHeadlessCMS Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root {
            --cms-sidebar-width: 268px;
        }

        body { background-color: #f5f6f8; }

        .cms-sidebar {
            width: var(--cms-sidebar-width);
            min-height: 100vh;
            background: linear-gradient(180deg, #1a1d29 0%, #14161f 100%);
            padding: 1.25rem 1rem 0;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .cms-sidebar-brand {
            padding: .25rem .25rem 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,.08);
            margin-bottom: 1.1rem;
        }

        .cms-sidebar-scroll {
            flex: 1;
            overflow-y: auto;
            padding-bottom: 1rem;
        }

        .cms-nav-section { margin-bottom: 1.5rem; }

        .cms-nav-section-title {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #6b7280;
            font-weight: 600;
            padding: 0 .75rem;
            margin-bottom: .5rem;
        }

        .cms-nav-link {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .55rem .75rem;
            border-radius: .5rem;
            color: #b8bcc8;
            font-size: .9rem;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: background .15s, color .15s, border-color .15s;
            margin-bottom: .15rem;
        }

        .cms-nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,.06);
        }

        .cms-nav-link.active {
            color: #fff;
            background: rgba(13,110,253,.18);
            border-left-color: #0d6efd;
        }

        .cms-nav-link i {
            width: 1.1rem;
            text-align: center;
            flex-shrink: 0;
        }

        .cms-sidebar-group-header {
            justify-content: flex-start;
            cursor: pointer;
        }

        .cms-sidebar-group-chevron {
            width: 0.9rem;
            font-size: .75rem;
            transition: transform .15s ease;
            flex-shrink: 0;
        }

        .cms-sidebar-group-header[aria-expanded="true"] .cms-sidebar-group-chevron {
            transform: rotate(90deg);
        }

        .cms-sidebar-entity-link { font-size: .85rem; }

        .cms-sidebar-search .input-group-text {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            color: #6b7280;
        }

        .cms-sidebar-search .form-control {
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.08);
            border-left: none;
            color: #e5e7eb;
            font-size: .85rem;
        }

        .cms-sidebar-search .form-control:focus {
            background: rgba(255,255,255,.09);
            color: #fff;
            box-shadow: none;
            border-color: rgba(255,255,255,.15);
        }

        .cms-sidebar-search .form-control::placeholder { color: #6b7280; }

        .cms-sidebar-footer {
            padding: .9rem .25rem 1rem;
            border-top: 1px solid rgba(255,255,255,.08);
        }

        .cms-content { flex: 1; min-width: 0; }

        .cms-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1040;
        }
        .cms-backdrop.show { display: block; }

        @@media (max-width: 991.98px) {
            .cms-sidebar {
                position: fixed;
                z-index: 1045;
                top: 0; left: 0;
                transform: translateX(-100%);
                transition: transform .2s ease;
            }
            .cms-sidebar.show { transform: translateX(0); }
        }
    </style>
</head>
<body>
    <div class="cms-backdrop" id="cmsBackdrop"></div>
    <div class="d-flex">
        <nav class="cms-sidebar d-flex flex-column" id="cmsSidebar">
            <div class="cms-sidebar-brand">
                <a href="/dami" class="d-flex align-items-center text-white text-decoration-none">
                    <i class="bi bi-layers-fill fs-4 me-2"></i>
                    <span class="fs-5 fw-semibold">DAMIHeadlessCMS</span>
                </a>
            </div>

            <div class="cms-sidebar-scroll">
                @if (User.IsInRole(CmsRoles.Admin) || User.IsInRole(CmsRoles.Operator))
                {
                    <div class="cms-nav-section">
                        <div class="cms-nav-section-title">Amministrazione</div>
                        <a href="/dami/users"
                           class="cms-nav-link @(IsActive("/dami/users") ? "active" : "")">
                            <i class="bi bi-people"></i> <span>Utenti</span>
                        </a>
                    </div>
                }

                <div class="cms-nav-section">
                    <div class="cms-nav-section-title">Struttura</div>
                    @if (User.IsInRole(CmsRoles.Admin))
                    {
                        <a href="/dami/scaffolding"
                           class="cms-nav-link @(IsActive("/dami/scaffolding") ? "active" : "")">
                            <i class="bi bi-diagram-3"></i> <span>Scaffolding</span>
                        </a>
                    }
                    <a href="/dami/localization-sources"
                       class="cms-nav-link @(IsActive("/dami/localization-sources") ? "active" : "")">
                        <i class="bi bi-translate"></i> <span>Localizzazioni</span>
                    </a>
                </div>

                @if (User.IsInRole(CmsRoles.Admin) || User.IsInRole(CmsRoles.Operator))
                {
                    <div class="cms-nav-section">
                        <div class="cms-nav-section-title">FFM</div>
                        <a href="/dami/ffm/giocatori"
                           class="cms-nav-link @(IsActive("/dami/ffm/giocatori") ? "active" : "")">
                            <i class="bi bi-person-badge"></i> <span>Database Giocatori</span>
                        </a>
                        <a href="/dami/ffm/squadre"
                           class="cms-nav-link @(IsActive("/dami/ffm/squadre") ? "active" : "")">
                            <i class="bi bi-shield"></i> <span>Squadre</span>
                        </a>
                    </div>
                }

                <div class="cms-nav-section">
                    <div class="cms-nav-section-title">Contenuti</div>
                    <a href="/dami/pages"
                       class="cms-nav-link @(IsActive("/dami/pages") ? "active" : "")">
                        <i class="bi bi-file-earmark-text"></i> <span>Pagine</span>
                    </a>
                    <a href="/dami/menus"
                       class="cms-nav-link @(IsActive("/dami/menus") ? "active" : "")">
                        <i class="bi bi-list-nested"></i> <span>Menu</span>
                    </a>
                </div>

                <div class="cms-nav-section">
                    <div class="cms-nav-section-title">Dati</div>
                    @{
                        var sidebarEntities = await Db.EntityDefinitions
                            .Where(e => e.IsEnabled)
                            .OrderBy(e => e.SortOrder)
                            .ThenBy(e => e.DisplayName)
                            .ToListAsync();

                        var sidebarGroups = sidebarEntities
                            .GroupBy(e => string.IsNullOrWhiteSpace(e.GroupName) ? (string.IsNullOrWhiteSpace(e.SchemaName) ? "Generale" : e.SchemaName) : e.GroupName)
                            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
                            .ToList();
                    }
                    @if (sidebarEntities.Count == 0)
                    {
                        <div class="px-3 py-2 text-white-50 small">Nessuna tabella scaffoldata</div>
                    }
                    else
                    {
                        <div class="px-1 mb-2">
                            <div class="input-group input-group-sm cms-sidebar-search">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input type="search" id="cmsSidebarEntitySearch" class="form-control" placeholder="Cerca...">
                            </div>
                        </div>
                        <div id="cmsSidebarEntityGroups">
                            @for (var groupIndex = 0; groupIndex < sidebarGroups.Count; groupIndex++)
                            {
                                var sidebarGroup = sidebarGroups[groupIndex];
                                var sidebarCollapseId = $"cmsSidebarGroup{groupIndex}";
                                <div class="cms-sidebar-group" data-group-index="@groupIndex">
                                    <button type="button"
                                            class="cms-nav-link cms-sidebar-group-header w-100 border-0 bg-transparent"
                                            data-bs-toggle="collapse" data-bs-target="#@sidebarCollapseId"
                                            aria-expanded="false" aria-controls="@sidebarCollapseId">
                                        <i class="bi bi-chevron-right cms-sidebar-group-chevron"></i>
                                        <span class="flex-fill text-truncate">@sidebarGroup.Key</span>
                                        <span class="badge bg-white bg-opacity-10 text-white-50">@sidebarGroup.Count()</span>
                                    </button>
                                    <ul class="nav nav-pills flex-column list-unstyled mb-1 collapse" id="@sidebarCollapseId">
                                        @foreach (var sidebarEntity in sidebarGroup)
                                        {
                                            var entityPath = $"/dami/{sidebarEntity.Id}";
                                            <li data-entity-name="@sidebarEntity.DisplayName.ToLowerInvariant()">
                                                <a href="@entityPath" class="cms-nav-link cms-sidebar-entity-link ps-4 @(IsActive(entityPath) ? "active" : "")">
                                                    <i class="bi bi-@(sidebarEntity.Icon ?? "table")"></i> <span>@sidebarEntity.DisplayName</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </div>
                        <p class="px-3 py-1 text-white-50 small mb-0 d-none" id="cmsSidebarEntityNoResults">Nessun risultato.</p>
                    }
                </div>
            </div>

            <div class="cms-sidebar-footer">
                <div class="d-flex align-items-center justify-content-between text-white-50 small">
                    <span class="text-truncate"><i class="bi bi-person-circle me-1"></i> @User.Identity?.Name</span>
                    <form method="post" action="/dami/account/logout" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-link text-white-50 p-0" title="Esci">
                            <i class="bi bi-box-arrow-right"></i>
                        </button>
                    </form>
                </div>
            </div>
        </nav>

        <div class="cms-content">
            <nav class="navbar navbar-light bg-white border-bottom px-3 d-lg-none sticky-top">
                <button class="btn btn-outline-secondary" type="button" id="cmsSidebarToggle">
                    <i class="bi bi-list"></i>
                </button>
                <span class="navbar-brand mb-0 h1">DAMIHeadlessCMS</span>
                <span style="width:38px;"></span>
            </nav>

            <main class="container-fluid p-3 p-lg-4">
                @if (TempData["StatusMessage"] is string statusMessage)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @statusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        (function () {
            const sidebar = document.getElementById('cmsSidebar');
            const backdrop = document.getElementById('cmsBackdrop');
            const toggleBtn = document.getElementById('cmsSidebarToggle');

            function openSidebar() {
                sidebar.classList.add('show');
                backdrop.classList.add('show');
            }
            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
            }

            toggleBtn?.addEventListener('click', () => {
                sidebar.classList.contains('show') ? closeSidebar() : openSidebar();
            });
            backdrop.addEventListener('click', closeSidebar);
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeSidebar();
            });
            sidebar.addEventListener('click', (e) => {
                if (e.target.closest('a')) closeSidebar();
            });
        })();

        // Filtro rapido per la sezione "Dati": nasconde le voci non
        // corrispondenti ed espande automaticamente i gruppi con risultati,
        // ripristinando l'accordion allo stato originale a campo vuoto.
        (function () {
            const searchInput = document.getElementById('cmsSidebarEntitySearch');
            const groupsContainer = document.getElementById('cmsSidebarEntityGroups');
            if (!searchInput || !groupsContainer) return;

            const groups = Array.from(groupsContainer.querySelectorAll('.cms-sidebar-group'));
            const noResults = document.getElementById('cmsSidebarEntityNoResults');
            const originalExpanded = groups.map(g => g.querySelector('.collapse').classList.contains('show'));

            function collapseInstance(el) {
                return bootstrap.Collapse.getOrCreateInstance(el, { toggle: false });
            }

            searchInput.addEventListener('input', () => {
                const query = searchInput.value.trim().toLowerCase();
                let anyVisible = false;

                groups.forEach((group, index) => {
                    const collapseEl = group.querySelector('.collapse');
                    const items = Array.from(collapseEl.querySelectorAll('li'));
                    let groupHasMatch = false;

                    items.forEach(item => {
                        const matches = query === '' || item.dataset.entityName.includes(query);
                        item.classList.toggle('d-none', !matches);
                        if (matches) groupHasMatch = true;
                    });

                    group.classList.toggle('d-none', !groupHasMatch);
                    if (groupHasMatch) anyVisible = true;

                    const instance = collapseInstance(collapseEl);
                    if (query !== '') {
                        groupHasMatch ? instance.show() : instance.hide();
                    } else {
                        originalExpanded[index] ? instance.show() : instance.hide();
                    }
                });

                noResults?.classList.toggle('d-none', anyVisible || query === '');
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>