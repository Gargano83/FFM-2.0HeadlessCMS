<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DAMIHeadlessCMS.TestHost</RootNamespace>
    <!-- docusaurusV3/ è il progetto sorgente (Node/TypeScript) del sito statico
         Regolamento — non è codice .NET, vive qui solo per comodità (visibile in
         Solution Explorer tramite i glob impliciti dell'SDK, nessuna voce manuale
         nel .slnx necessaria) e per poter rigenerare la build in futuro. Le cartelle
         qui escluse (create solo da 'yarn install'/'yarn build', mai committate,
         vedi docusaurusV3/.gitignore) possono contenere decine di migliaia di file:
         escluderle dai glob impliciti evita che MSBuild le scansioni ad ogni build.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);docusaurusV3/node_modules/**;docusaurusV3/.docusaurus/**;docusaurusV3/build/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DAMIHeadlessCMS.Data\DAMIHeadlessCMS.Data.csproj" />
    <ProjectReference Include="..\DAMIHeadlessCMS.Admin\DAMIHeadlessCMS.Admin.csproj" />
  </ItemGroup>
  
  <ItemGroup>
    <Folder Include="Controllers\" />
    <Folder Include="Models\PublicSite\" />
    <Folder Include="PublicSite\" />
    <Folder Include="ViewComponents\" />
    <Folder Include="Views\Home\" />
    <Folder Include="Views\Comunicazioni\" />
    <Folder Include="Views\AreaRiservata\" />
    <Folder Include="Views\LegacyMediaTools\" />
    <Folder Include="Views\Statistiche\" />
    <Folder Include="Views\Pages\" />
    <Folder Include="Views\Shared\Components\MainMenu\" />
    <Folder Include="wwwroot\img\" />
  </ItemGroup>

</Project>
