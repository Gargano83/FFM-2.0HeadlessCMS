@using DAMIHeadlessCMS.TestHost.Models.PublicSite
@model CmsPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-5">
    <h1 class="mb-4">@Model.Title</h1>

    @foreach (var block in Model.Blocks)
    {
        @if (block is CmsHtmlBlockViewModel htmlBlock)
        {
            <div class="cms-block cms-block-html mb-4">
                @Html.Raw(htmlBlock.Html)
            </div>
        }
        else if (block is CmsEntityListBlockViewModel entityListBlock)
        {
            <div class="cms-block cms-block-entity-list mb-4">
                <partial name="_EntityListBlock" model="entityListBlock" />
            </div>
        }
    }
</div>
