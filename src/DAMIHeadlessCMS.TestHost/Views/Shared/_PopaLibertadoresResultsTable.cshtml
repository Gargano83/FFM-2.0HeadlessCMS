@model System.Collections.Generic.IReadOnlyList<DAMIHeadlessCMS.TestHost.Models.PublicSite.PopaLibertadoresResultRowViewModel>

@if (Model.Count == 0)
{
    <p class="text-body-secondary mb-0">Nessun dato disponibile.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Stagione</th>
                    <th scope="col">Vincitore</th>
                    <th scope="col">Finalista perdente</th>
                    <th scope="col">Andata</th>
                    <th scope="col">Ritorno</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <th scope="row">@row.SeasonLabel</th>
                        <td>@await Html.PartialAsync("_TeamCell", row.Vincitore)</td>
                        <td>@await Html.PartialAsync("_TeamCell", row.FinalistaPerdente)</td>
                        <td>
                            <div>@row.RisultatoAndata</div>
                            <div class="small text-body-secondary">
                                @await Html.PartialAsync("_TeamCell", row.SedeAndata)
                                @row.SedeAndataStadio
                            </div>
                        </td>
                        <td>
                            <div>@row.RisultatoRitorno</div>
                            <div class="small text-body-secondary">
                                @await Html.PartialAsync("_TeamCell", row.SedeRitorno)
                                @row.SedeRitornoStadio
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
