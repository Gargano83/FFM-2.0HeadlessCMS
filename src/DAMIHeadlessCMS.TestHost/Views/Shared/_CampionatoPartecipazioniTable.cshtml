@model System.Collections.Generic.IReadOnlyList<DAMIHeadlessCMS.TestHost.Models.PublicSite.PartecipazioniRowViewModel>

@if (Model.Count == 0)
{
    <p class="text-body-secondary mb-0">Nessun dato disponibile.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Squadra</th>
                    <th scope="col">Titoli</th>
                    <th scope="col">2&deg; posto</th>
                    <th scope="col">3&deg; posto</th>
                    <th scope="col">Podi</th>
                    <th scope="col">Partecipazioni</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model)
                {
                    <tr>
                        <td>@await Html.PartialAsync("_TeamCell", row.Team)</td>
                        <td>@row.Titoli</td>
                        <td>@row.SecondoPosto</td>
                        <td>@row.TerzoPosto</td>
                        <td>@row.Podi</td>
                        <td>@row.Partecipazioni</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
