@using DAMIHeadlessCMS.TestHost.Models.PublicSite
@model MainMenuViewModel

<nav class="navbar navbar-expand-lg public-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold" href="/">FFM 2.0</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavCollapse"
                aria-controls="mainNavCollapse" aria-expanded="false" aria-label="Apri/chiudi menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavCollapse">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                @if (Model.Items.Count == 0)
                {
                    <li class="nav-item">
                        <span class="navbar-text text-body-secondary small">
                            Nessun menu "@DAMIHeadlessCMS.TestHost.ViewComponents.MainMenuViewComponent.MainMenuName" configurato — crealo da <a href="/dami/menus">/dami/menus</a>.
                        </span>
                    </li>
                }
                else
                {
                    foreach (var node in Model.Items)
                    {
                        @await Html.PartialAsync("_MenuNode", node)
                    }
                }
                <li class="nav-item ms-lg-2">
                    @if (Model.IsPublicUserAuthenticated)
                    {
                        <a class="nav-link" href="/area-riservata" title="La mia area riservata">
                            <i class="bi bi-person-check-fill fs-5"></i>
                        </a>
                    }
                    else
                    {
                        <a class="nav-link" href="/area-riservata/login" title="Accedi all'area riservata">
                            <i class="bi bi-person-circle fs-5"></i>
                        </a>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>
