@using DAMIHeadlessCMS.TestHost.Models.PublicSite
@model MainMenuViewModel

<nav class="navbar navbar-expand-lg navbar-dark public-navbar sticky-top">
    <div class="container">
        <a class="navbar-brand" href="/">
            <img src="/img/FFM_Oriz_Bianco.png" alt="FFM - Fantasy Football Manager" class="ffm-logo" />
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavCollapse"
                aria-controls="mainNavCollapse" aria-expanded="false" aria-label="Apri/chiudi menu">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNavCollapse">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                @if (Model.Items.Count == 0)
                {
                    <li class="nav-item">
                        <span class="navbar-text text-white-50 small">
                            Nessun menu "@DAMIHeadlessCMS.TestHost.ViewComponents.MainMenuViewComponent.MainMenuName" configurato — crealo da <a class="text-white" href="/dami/menus">/dami/menus</a>.
                        </span>
                    </li>
                }
                else
                {
                    foreach (var node in Model.Items)
                    {
                        @await Html.PartialAsync("_MenuNode", node)
                    }
                }
                <li class="nav-item ms-lg-3">
                    @if (Model.IsPublicUserAuthenticated)
                    {
                        <a class="nav-link" href="/area-riservata" title="La mia area riservata">
                            <i class="bi bi-person-check-fill fs-5"></i>
                        </a>
                    }
                    else
                    {
                        <a class="nav-link" href="/area-riservata/login" title="Accedi all'area riservata">
                            <i class="bi bi-person-circle fs-5"></i>
                        </a>
                    }
                </li>
                <li class="nav-item d-none d-lg-block vr mx-1 opacity-25" aria-hidden="true"></li>
                <li class="nav-item ms-lg-1">
                    @* Icona distinta (scudo, non persona) per l'utenza di backoffice: le due
                       utenze — area riservata (WN_Utenti) e backoffice (Identity) — sono
                       completamente separate, non devono essere confondibili a colpo d'occhio. *@
                    @if (Model.IsBackofficeAuthenticated)
                    {
                        <a class="nav-link text-white-50" href="/dami" title="Vai al backoffice">
                            <i class="bi bi-shield-check fs-5"></i>
                        </a>
                    }
                    else
                    {
                        <a class="nav-link text-white-50" href="/dami/account/login" title="Accedi al backoffice">
                            <i class="bi bi-shield-lock fs-5"></i>
                        </a>
                    }
                </li>
            </ul>
        </div>
    </div>
</nav>
