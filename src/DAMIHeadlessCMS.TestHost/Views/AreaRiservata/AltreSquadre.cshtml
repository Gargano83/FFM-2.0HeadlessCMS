@model System.Collections.Generic.IReadOnlyList<DAMIHeadlessCMS.Admin.Ffm.Models.SquadraListItemDto>
@{
    ViewData["Title"] = "Altre squadre";
}

<div class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Altre squadre</h1>
        <a href="/area-riservata" class="btn btn-sm btn-outline-secondary">&larr; La mia squadra</a>
    </div>

    @if (Model.Count == 0)
    {
        <p class="text-body-secondary">Nessuna squadra disponibile.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var squadra in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <a class="text-decoration-none text-body" href="/area-riservata/altre-squadre/@squadra.Id">
                        <div class="h-100 p-3 border rounded">
                            <h2 class="h6 mb-2">@squadra.Nome</h2>
                            <div class="small text-body-secondary">
                                @if (!string.IsNullOrWhiteSpace(squadra.Presidente))
                                {
                                    <div>Presidente: @squadra.Presidente</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(squadra.Allenatore))
                                {
                                    <div>Allenatore: @squadra.Allenatore</div>
                                }
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
