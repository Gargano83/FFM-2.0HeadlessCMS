@model DAMIHeadlessCMS.TestHost.Models.PublicSite.ModificaGiocatoreViewModel
@{
    ViewData["Title"] = "Modifica giocatore";
    var stati = (string[])ViewBag.StatiGiocatore;
}

<div class="container py-4 py-lg-5" style="max-width: 480px;">
    <a href="/area-riservata" class="small d-inline-block mb-3">&larr; La mia squadra</a>
    <h1 class="h3 mb-1">@Model.NomeCompleto</h1>
    <p class="text-body-secondary mb-4">@Model.Ruolo</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    <form asp-action="ModificaGiocatore" asp-route-idGiocatore="@Model.IdGiocatore" method="post">
        <input type="hidden" asp-for="IdGiocatore" />
        <input type="hidden" asp-for="NomeCompleto" />
        <input type="hidden" asp-for="Ruolo" />

        <div class="mb-3">
            <label asp-for="Stato" class="form-label"></label>
            <select asp-for="Stato" class="form-select">
                @foreach (var stato in stati)
                {
                    <option value="@stato">@(string.IsNullOrEmpty(stato) ? "—" : stato)</option>
                }
            </select>
        </div>

        <div class="mb-4">
            <label asp-for="Mesi" class="form-label"></label>
            <input asp-for="Mesi" type="number" min="0" max="120" class="form-control" />
            <span asp-validation-for="Mesi" class="text-danger small"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Salva</button>
            <a href="/area-riservata" class="btn btn-outline-secondary">Annulla</a>
        </div>
    </form>
</div>
