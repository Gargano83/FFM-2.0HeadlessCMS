@model DAMIHeadlessCMS.TestHost.Models.PublicSite.AggiungiGiocatoreViewModel
@{
    ViewData["Title"] = "Aggiungi giocatore";
}

<div class="container py-4 py-lg-5" style="max-width: 480px;">
    <a href="/area-riservata" class="small d-inline-block mb-3">&larr; La mia squadra</a>
    <h1 class="h3 mb-4">Aggiungi giocatore</h1>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @if (Model.Disponibili.Count == 0)
    {
        <p class="text-body-secondary">Nessun giocatore svincolato disponibile al momento.</p>
    }
    else
    {
        <form asp-action="AggiungiGiocatore" method="post">
            <div class="mb-3">
                <label asp-for="IdGiocatoreSelezionato" class="form-label"></label>
                <select asp-for="IdGiocatoreSelezionato" class="form-select">
                    <option value="">— Seleziona —</option>
                    @foreach (var giocatore in Model.Disponibili)
                    {
                        <option value="@giocatore.Id">@giocatore.NomeCompleto (@giocatore.Ruolo)</option>
                    }
                </select>
                <span asp-validation-for="IdGiocatoreSelezionato" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ValoreDiMercato" class="form-label"></label>
                <input asp-for="ValoreDiMercato" type="number" step="0.1" min="0" class="form-control" />
                <span asp-validation-for="ValoreDiMercato" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Stipendio" class="form-label"></label>
                <input asp-for="Stipendio" type="number" step="0.1" min="0" class="form-control" />
                <span asp-validation-for="Stipendio" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Aggiungi</button>
                <a href="/area-riservata" class="btn btn-outline-secondary">Annulla</a>
            </div>
        </form>
    }
</div>
