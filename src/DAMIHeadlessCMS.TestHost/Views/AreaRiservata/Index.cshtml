@using DAMIHeadlessCMS.TestHost.Models.PublicSite
@model SquadraViewModel
@{
    ViewData["Title"] = Model.Info.NomeSquadra;
    var statiGiocatore = new[] { "", "Lista A", "Lista A (Pr)", "No Serie A", "In prestito", "Fuori Rosa" };
}

<div class="container py-4 py-lg-5">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
        <h1 class="mb-0" id="squadraTitolo">@Model.Info.NomeSquadra</h1>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-dark" disabled title="In arrivo">
                <i class="bi bi-arrow-left-right me-1"></i>Trasferimenti
            </button>
            <form asp-controller="AreaRiservata" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Esci</button>
            </form>
        </div>
    </div>

    <div class="mb-4" style="max-width:360px;">
        <label for="squadraSelect" class="form-label text-body-secondary small mb-1">Vuoi consultare un'altra squadra?</label>
        <select id="squadraSelect" class="form-select">
            @foreach (var s in Model.TutteLeSquadre)
            {
                <option value="@s.Id" selected="@(s.Id == Model.Info.IdSquadra ? "selected" : null)">@s.Nome</option>
            }
        </select>
    </div>

    <div id="superAdminBanner" class="alert alert-warning d-flex align-items-center gap-2 @(Model.IsSuperAdminOverride ? "" : "d-none")">
        <i class="bi bi-shield-exclamation fs-5"></i>
        <div>Stai modificando questa squadra come amministratore: non è la tua squadra.</div>
    </div>

    <div id="squadraLoadError" class="alert alert-danger d-none"></div>

    <div id="squadraContent"></div>
</div>

<div class="modal fade" id="modificaGiocatoreModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Dettaglio giocatore</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <dl class="row mb-3">
                    <dt class="col-5">Nome</dt><dd class="col-7" id="modNome"></dd>
                    <dt class="col-5">Cognome</dt><dd class="col-7" id="modCognome"></dd>
                    <dt class="col-5">Ruolo</dt><dd class="col-7" id="modRuolo"></dd>
                    <dt class="col-5">Data di nascita</dt><dd class="col-7" id="modDataNascita"></dd>
                    <dt class="col-5">Valore (VDM) &euro;</dt><dd class="col-7" id="modValore"></dd>
                    <dt class="col-5">Stipendio &euro;</dt><dd class="col-7" id="modStipendio"></dd>
                </dl>
                <label for="modStato" class="form-label fw-bold">Stato</label>
                <select class="form-select" id="modStato">
                    @foreach (var stato in statiGiocatore)
                    {
                        <option value="@stato">@(string.IsNullOrEmpty(stato) ? "—" : stato)</option>
                    }
                </select>
                <div class="text-danger small mt-2 d-none" id="modErrore"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="modSalva"><i class="bi bi-check-lg me-1"></i>Salva</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Chiudi</button>
            </div>
        </div>
    </div>
</div>

<!--
    Personalizzazione divisa squadra — fase 6 (sviluppata e validata qui, in
    DAMIHeadlessCMS.TestHost, prima dell'integrazione su FFM2.0Core: vedi
    claude/piano-divisa-squadra.md). Modale statica fuori da #squadraContent,
    stesso pattern di #modificaGiocatoreModal: il punto di ingresso (pulsante
    dentro renderInfo()) va riagganciato ad ogni renderSquadra(), la modale e
    la sua interazione interna sono invece agganciate una sola volta qui sotto.
-->
<div class="modal fade" id="divisaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Personalizza divisa</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div id="divisaCaricamento" class="text-center py-5">
                    <div class="spinner-border" role="status"><span class="visually-hidden">Caricamento...</span></div>
                </div>
                <div id="divisaErrore" class="alert alert-danger d-none"></div>
                <div id="divisaContenuto" class="d-none">
                    <ul class="nav nav-pills mb-3" id="divisaStepNav">
                        <li class="nav-item"><button type="button" class="nav-link active" data-step="1">1. Modello</button></li>
                        <li class="nav-item"><button type="button" class="nav-link" data-step="2">2. Colori</button></li>
                        <li class="nav-item"><button type="button" class="nav-link" data-step="3">3. Sponsor</button></li>
                    </ul>
                    <div class="row g-4">
                        <div class="col-12 col-lg-7">
                            <div id="divisaStep1">
                                <p class="text-body-secondary small">Scegli il modello di maglia.</p>
                                <div class="row row-cols-3 row-cols-sm-4 g-2" id="divisaGalleria" style="max-height:360px; overflow-y:auto;"></div>
                            </div>
                            <div id="divisaStep2" class="d-none">
                                <p class="text-body-secondary small">Scegli i tre colori della maglia.</p>
                                <div class="row g-3">
                                    <div class="col-4" id="divisaColore1Wrapper">
                                        <label class="form-label small mb-1" for="divisaColore1">Colore 1</label>
                                        <input type="color" id="divisaColore1" class="form-control form-control-color w-100">
                                    </div>
                                    <div class="col-4" id="divisaColore2Wrapper">
                                        <label class="form-label small mb-1" for="divisaColore2">Colore 2</label>
                                        <input type="color" id="divisaColore2" class="form-control form-control-color w-100">
                                    </div>
                                    <div class="col-4" id="divisaColore3Wrapper">
                                        <label class="form-label small mb-1" for="divisaColore3">Colore 3</label>
                                        <input type="color" id="divisaColore3" class="form-control form-control-color w-100">
                                    </div>
                                </div>
                                <div class="form-text small" id="divisaPaletteNonDisponibiliNota" hidden>
                                    Questo template non prevede tutte e 3 le palette: i colori non applicabili sono nascosti
                                    (rilevato automaticamente dal file del template — fase 10).
                                </div>
                            </div>
                            <div id="divisaStep3" class="d-none">
                                <p class="text-body-secondary small">Sponsor (testo libero, facoltativo).</p>
                                <div class="mb-3">
                                    <label for="divisaTestoSponsor" class="form-label small mb-1">Sponsor</label>
                                    <input type="text" id="divisaTestoSponsor" class="form-control" maxlength="50" placeholder="Es. NomeSponsor">
                                </div>
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-4">
                                        <label class="form-label small mb-1" for="divisaColoreTestoSponsor">Testo</label>
                                        <input type="color" id="divisaColoreTestoSponsor" class="form-control form-control-color w-100">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small mb-1" for="divisaColoreContornoTestoSponsor">Contorno</label>
                                        <input type="color" id="divisaColoreContornoTestoSponsor" class="form-control form-control-color w-100">
                                    </div>
                                    <div class="col-4">
                                        <label class="form-label small mb-1" for="divisaColoreSfondoTestoSponsor">Sfondo</label>
                                        <input type="color" id="divisaColoreSfondoTestoSponsor" class="form-control form-control-color w-100">
                                    </div>
                                </div>
                                <div class="d-flex gap-3">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="divisaUsaContornoSponsor">
                                        <label class="form-check-label small" for="divisaUsaContornoSponsor">Applica contorno</label>
                                    </div>
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="divisaUsaSfondoSponsor">
                                        <label class="form-check-label small" for="divisaUsaSfondoSponsor">Applica sfondo</label>
                                    </div>
                                </div>

                                <hr class="my-3">

                                <div class="mb-3">
                                    <label class="form-label small mb-1">Posizione</label>
                                    <div class="btn-group w-100" role="group" id="divisaPosizioneSponsorGroup"></div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label small mb-1" for="divisaFontTestoSponsor">Font</label>
                                    <select id="divisaFontTestoSponsor" class="form-select"></select>
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small mb-0" for="divisaColoreOmbraTestoSponsor">Ombreggiatura</label>
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" id="divisaUsaOmbraSponsor">
                                            <label class="form-check-label small" for="divisaUsaOmbraSponsor">Applica ombra</label>
                                        </div>
                                    </div>
                                    <input type="color" id="divisaColoreOmbraTestoSponsor" class="form-control form-control-color w-100">
                                </div>

                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="form-label small mb-0" for="divisaDimensioneTestoSponsor">
                                            Dimensione (<span id="divisaDimensioneTestoSponsorValore">100</span>%)
                                        </label>
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" id="divisaAutoFitTestoSponsor">
                                            <label class="form-check-label small" for="divisaAutoFitTestoSponsor">Auto-fit</label>
                                        </div>
                                    </div>
                                    <input type="range" id="divisaDimensioneTestoSponsor" class="form-range" min="60" max="140" step="5" value="100">
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="divisaLetteringAdArcoTestoSponsor">
                                    <label class="form-check-label small" for="divisaLetteringAdArcoTestoSponsor">Lettering ad arco</label>
                                </div>

                                <div class="text-danger small mt-3 d-none" id="divisaErroreSalvataggio"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button type="button" class="btn btn-outline-secondary" id="divisaIndietro" disabled>
                                    <i class="bi bi-arrow-left me-1"></i>Indietro
                                </button>
                                <button type="button" class="btn btn-primary" id="divisaAvanti">
                                    Avanti<i class="bi bi-arrow-right ms-1"></i>
                                </button>
                                <button type="button" class="btn btn-success d-none" id="divisaSalva">
                                    <i class="bi bi-check-lg me-1"></i>Salva
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-lg-5 text-center">
                            <canvas id="divisaAnteprimaCanvas" width="512" height="512"
                                    style="max-width:100%; height:auto; background:repeating-conic-gradient(#e9ecef 0% 25%, #fff 0% 50%) 50% / 24px 24px;"></canvas>
                            <div class="text-danger small mt-2 d-none" id="divisaErroreMotore"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@{
    var jsonOptions = new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase };
}
@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/_content/DAMIHeadlessCMS.Admin/fonts/divisa/divisa-fonts.js"></script>
    <script src="~/js/divisa/divisa-render-engine.js"></script>
    <script>
        (function () {
            const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const ownIdSquadra = @(Html.Raw(System.Text.Json.JsonSerializer.Serialize((int?)ViewBag.IdSquadraUtenteCorrente, jsonOptions)));
            const contentEl = document.getElementById('squadraContent');
            const titoloEl = document.getElementById('squadraTitolo');
            const selectEl = document.getElementById('squadraSelect');
            const bannerEl = document.getElementById('superAdminBanner');
            const errorEl = document.getElementById('squadraLoadError');
            const modalEl = document.getElementById('modificaGiocatoreModal');
            const modal = new bootstrap.Modal(modalEl);

            // --- Personalizzazione divisa squadra (fase 6) ---
            const divisaModalEl = document.getElementById('divisaModal');
            const divisaModal = new bootstrap.Modal(divisaModalEl);
            const DIVISA_BASE_URL_TEMPLATE = '/img/divisa/template';
            const DIVISA_BASE_URL_CONDIVISI = '/img/divisa/condivisi';
            let divisaCatalogo = [];
            let divisaTemplateSelezionatoId = null;
            let divisaStepCorrente = 1;
            // Migliorie lettering sponsor (fase 8.4) — "Alto" replica la posizione
            // fissa storica, come per il default lato server (DivisaSquadraDto).
            let divisaPosizioneSponsorSelezionata = 'Alto';

            let currentData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model, jsonOptions));
            const nuoviGiocatoriIds = new Set();

            function euro(v) {
                return v === null || v === undefined ? '—' : Number(v).toLocaleString('it-IT', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
            }

            function formatData(iso) {
                if (!iso) return '—';
                const d = new Date(iso);
                return d.toLocaleDateString('it-IT');
            }

            async function apiFetch(url, options = {}) {
                const res = await fetch(url, {
                    ...options,
                    headers: {
                        'Content-Type': 'application/json',
                        ...(csrfToken ? { 'X-CSRF-TOKEN': csrfToken } : {}),
                        ...(options.headers || {})
                    }
                });
                if (!res.ok) {
                    let message = `Operazione non riuscita (HTTP ${res.status}).`;
                    try {
                        const body = await res.json();
                        if (body?.error) message = body.error;
                    } catch { /* risposta senza corpo JSON, va bene il messaggio generico */ }
                    throw new Error(message);
                }
                return res.status === 204 ? null : res.json();
            }

            function renderInfo(info) {
                return `
                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h2 class="h5 mb-0">Squadra</h2>
                                ${currentData.puoModificare ? `
                                <button type="button" class="btn btn-sm btn-outline-primary cms-personalizza-divisa">
                                    <i class="bi bi-palette2 me-1"></i>Personalizza divisa
                                </button>` : ''}
                            </div>
                            <dl class="row mb-0 small">
                                <dt class="col-6">Presidente</dt><dd class="col-6">${info.presidente ?? ''}</dd>
                                <dt class="col-6">Vice presidente</dt><dd class="col-6">${info.vicePresidente ?? ''}</dd>
                                <dt class="col-6">Allenatore</dt><dd class="col-6">${info.allenatore ?? ''}</dd>
                                <dt class="col-6">Contratto allenatore</dt>
                                <dd class="col-6">${info.durataContrattoAllenatore} mesi &mdash; ${euro(info.stipendioAllenatore)}</dd>
                            </dl>
                            <hr />
                            <div class="row text-center small g-2">
                                <div class="col-4"><div class="fw-bold fs-5">${info.tesserati}</div>Tesserati</div>
                                <div class="col-4"><div class="fw-bold fs-5">${info.inPrestito}</div>In prestito</div>
                                <div class="col-4"><div class="fw-bold fs-5">${info.inRosa}</div>In rosa</div>
                                <div class="col-4"><div class="fw-bold fs-5">${info.aPrestito}</div>A prestito</div>
                                <div class="col-4"><div class="fw-bold fs-5">${info.under22InRosa}</div>Under 22 in rosa</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="border rounded p-3 h-100">
                            <h2 class="h5 mb-3">Finanze</h2>
                            <dl class="row mb-0 small">
                                <dt class="col-8">Rimanenza stagione precedente</dt><dd class="col-4 text-end">${euro(info.rimanenzaStagionePrecedente)}</dd>
                                <dt class="col-8">Refill ranking</dt><dd class="col-4 text-end">${euro(info.refillRanking)}</dd>
                                <dt class="col-8">Refill valore società</dt><dd class="col-4 text-end">${euro(info.refillValoreSocieta)}</dd>
                                <dt class="col-8">Refill stadio</dt><dd class="col-4 text-end">${euro(info.refillStadio)}</dd>
                                <dt class="col-8">Refill stipendi</dt><dd class="col-4 text-end">${euro(info.refillStipendi)}</dd>
                                <dt class="col-8">Monte stipendi</dt><dd class="col-4 text-end">${euro(info.monteStipendi)}</dd>
                                <dt class="col-8">Bilancio mercato</dt><dd class="col-4 text-end">${euro(info.bilancioMercato)}</dd>
                                <dt class="col-8 fw-bold">Fair play finanziario</dt><dd class="col-4 text-end fw-bold">${euro(info.fairPlayFinanziario)}</dd>
                            </dl>
                        </div>
                    </div>`;
            }

            function renderSearchBar() {
                return `
                    <div class="position-relative mb-3" style="max-width:420px;">
                        <label for="giocatoreSearchInput" class="form-label small text-body-secondary mb-1">Aggiungi un giocatore</label>
                        <input type="search" id="giocatoreSearchInput" class="form-control" placeholder="Cerca un giocatore svincolato per nome..." autocomplete="off">
                        <div id="giocatoreSearchResults" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index:1000; max-height:280px; overflow-y:auto;"></div>
                    </div>`;
            }

            function renderRosaRow(g) {
                const isNuovo = nuoviGiocatoriIds.has(g.id);
                const mostraAzioni = currentData.puoModificare || currentData.puoAggiungereRimuovere;
                const azioni = mostraAzioni ? `
                    <td class="text-nowrap">
                        ${currentData.puoModificare ? `
                        <button type="button" class="btn btn-sm btn-outline-secondary cms-modifica-giocatore" data-id="${g.id}">
                            <i class="bi bi-pencil"></i>
                        </button>` : ''}
                        ${currentData.puoAggiungereRimuovere ? `
                        <button type="button" class="btn btn-sm btn-outline-danger cms-rimuovi-giocatore" data-id="${g.id}" data-nome="${g.nomeCompleto}">
                            <i class="bi bi-trash"></i>
                        </button>` : ''}
                    </td>` : '';
                return `
                    <tr class="${isNuovo ? 'table-success' : ''}">
                        <td>${g.id}</td>
                        <td>${g.stato ?? ''}</td>
                        <td>${g.u22 ? 'U22' : ''}</td>
                        <td>${g.ruolo ?? ''}</td>
                        <td>${g.eta}</td>
                        <td>${g.nomeCompleto}${isNuovo ? ' <span class="badge bg-success ms-1">Nuovo</span>' : ''}</td>
                        <td>${g.valoreDiMercato != null ? Number(g.valoreDiMercato).toLocaleString('it-IT', { minimumFractionDigits: 1 }) : '—'}</td>
                        <td>${g.stipendio != null ? Number(g.stipendio).toLocaleString('it-IT', { minimumFractionDigits: 1 }) : '—'}</td>
                        ${azioni}
                    </tr>`;
            }

            function renderRosa(data) {
                const azioniHeader = (data.puoModificare || data.puoAggiungereRimuovere) ? '<th scope="col">Azioni</th>' : '';
                const rows = data.rosa.length === 0
                    ? `<tr><td colspan="9" class="text-body-secondary">Nessun giocatore in rosa.</td></tr>`
                    : data.rosa.map(renderRosaRow).join('');

                return `
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="h5 mb-0">Rosa</h2>
                    </div>
                    ${data.puoAggiungereRimuovere ? renderSearchBar() : ''}
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead>
                                <tr>
                                    <th scope="col">Id</th>
                                    <th scope="col">Stato</th>
                                    <th scope="col">U22</th>
                                    <th scope="col">Ruolo</th>
                                    <th scope="col">Età</th>
                                    <th scope="col">Nome</th>
                                    <th scope="col">VDM</th>
                                    <th scope="col">Stipendio</th>
                                    ${azioniHeader}
                                </tr>
                            </thead>
                            <tbody>${rows}</tbody>
                        </table>
                    </div>`;
            }

            function renderSquadra(data) {
                currentData = data;
                titoloEl.textContent = data.info.nomeSquadra;
                document.title = data.info.nomeSquadra;
                bannerEl.classList.toggle('d-none', !data.isSuperAdminOverride);
                if (selectEl.value !== String(data.info.idSquadra)) selectEl.value = data.info.idSquadra;

                contentEl.innerHTML = `
                    ${!data.info.abilitaModifica ? '<div class="alert alert-warning">Le modifiche alla rosa non sono al momento consentite (mercato chiuso).</div>' : ''}
                    <div class="row g-4 mb-4">${renderInfo(data.info)}</div>
                    ${renderRosa(data)}`;

                wireRosaEvents();
                wireSearchBar();
                wireDivisaButton();
            }

            // --- Cambio squadra dal selettore: fetch senza reload, URL aggiornata via
            // pushState (bookmarkabile/condivisibile, a differenza del legacy che non
            // cambiava mai URL, ma senza il costo di un reload completo di pagina). ---
            async function switchSquadra(idSquadra, { pushState = true } = {}) {
                errorEl.classList.add('d-none');
                selectEl.disabled = true;
                try {
                    const data = await apiFetch(`/area-riservata/api/squadre/${idSquadra}`);
                    renderSquadra(data);
                    if (pushState) {
                        const url = idSquadra === ownIdSquadra ? '/area-riservata' : `/area-riservata/altre-squadre/${idSquadra}`;
                        history.pushState({ idSquadra }, '', url);
                    }
                } catch (err) {
                    errorEl.textContent = err.message;
                    errorEl.classList.remove('d-none');
                    selectEl.value = currentData.info.idSquadra;
                } finally {
                    selectEl.disabled = false;
                }
            }

            selectEl.addEventListener('change', () => switchSquadra(Number(selectEl.value)));

            window.addEventListener('popstate', (e) => {
                const idSquadra = e.state?.idSquadra ?? ownIdSquadra;
                switchSquadra(idSquadra, { pushState: false });
            });

            // --- Ricerca/aggiunta giocatore (autocompletamento) ---
            function wireSearchBar() {
                const input = document.getElementById('giocatoreSearchInput');
                const results = document.getElementById('giocatoreSearchResults');
                if (!input) return;

                let debounceTimer = null;

                input.addEventListener('input', () => {
                    clearTimeout(debounceTimer);
                    const q = input.value.trim();
                    if (q.length < 2) {
                        results.classList.add('d-none');
                        results.innerHTML = '';
                        return;
                    }
                    debounceTimer = setTimeout(async () => {
                        try {
                            const matches = await apiFetch(`/area-riservata/api/giocatori/cerca?q=${encodeURIComponent(q)}`);
                            if (matches.length === 0) {
                                results.innerHTML = '<div class="list-group-item text-body-secondary small">Nessun giocatore trovato.</div>';
                            } else {
                                results.innerHTML = matches.map(m => `
                                    <button type="button" class="list-group-item list-group-item-action cms-aggiungi-giocatore" data-id="${m.id}">
                                        <strong>${m.nomeCompleto}</strong>
                                        <span class="text-body-secondary small"> — ${m.ruolo ?? ''}</span>
                                    </button>`).join('');
                            }
                            results.classList.remove('d-none');
                        } catch (err) {
                            results.innerHTML = `<div class="list-group-item text-danger small">${err.message}</div>`;
                            results.classList.remove('d-none');
                        }
                    }, 300);
                });

                document.addEventListener('click', (e) => {
                    if (!results.contains(e.target) && e.target !== input) {
                        results.classList.add('d-none');
                    }
                });

                results.addEventListener('click', async (e) => {
                    const btn = e.target.closest('.cms-aggiungi-giocatore');
                    if (!btn) return;
                    const idGiocatore = Number(btn.dataset.id);
                    try {
                        const data = await apiFetch(`/area-riservata/api/squadre/${currentData.info.idSquadra}/giocatori/${idGiocatore}`, { method: 'POST' });
                        nuoviGiocatoriIds.add(idGiocatore);
                        input.value = '';
                        results.classList.add('d-none');
                        results.innerHTML = '';
                        renderSquadra(data);
                    } catch (err) {
                        results.innerHTML = `<div class="list-group-item text-danger small">${err.message}</div>`;
                    }
                });
            }

            // --- Modifica/rimozione giocatore in rosa ---
            let giocatoreInModifica = null;

            function wireRosaEvents() {
                contentEl.querySelectorAll('.cms-modifica-giocatore').forEach(btn => {
                    btn.addEventListener('click', () => apriModaleModifica(Number(btn.dataset.id)));
                });
                contentEl.querySelectorAll('.cms-rimuovi-giocatore').forEach(btn => {
                    btn.addEventListener('click', () => rimuoviGiocatore(Number(btn.dataset.id), btn.dataset.nome));
                });
            }

            function apriModaleModifica(idGiocatore) {
                giocatoreInModifica = currentData.rosa.find(g => g.id === idGiocatore);
                if (!giocatoreInModifica) return;

                document.getElementById('modNome').textContent = giocatoreInModifica.nome;
                document.getElementById('modCognome').textContent = giocatoreInModifica.cognome;
                document.getElementById('modRuolo').textContent = giocatoreInModifica.ruolo ?? '—';
                document.getElementById('modDataNascita').textContent = formatData(giocatoreInModifica.dataDiNascita);
                document.getElementById('modValore').textContent = euro(giocatoreInModifica.valoreDiMercato);
                document.getElementById('modStipendio').textContent = euro(giocatoreInModifica.stipendio);
                document.getElementById('modStato').value = giocatoreInModifica.stato ?? '';
                document.getElementById('modErrore').classList.add('d-none');

                modal.show();
            }

            document.getElementById('modSalva').addEventListener('click', async () => {
                if (!giocatoreInModifica) return;
                const modErrore = document.getElementById('modErrore');
                modErrore.classList.add('d-none');
                try {
                    const data = await apiFetch(
                        `/area-riservata/api/squadre/${currentData.info.idSquadra}/giocatori/${giocatoreInModifica.id}`,
                        {
                            method: 'PUT',
                            body: JSON.stringify({ mesi: giocatoreInModifica.mesi, stato: document.getElementById('modStato').value || null })
                        }
                    );
                    modal.hide();
                    renderSquadra(data);
                } catch (err) {
                    modErrore.textContent = err.message;
                    modErrore.classList.remove('d-none');
                }
            });

            async function rimuoviGiocatore(idGiocatore, nome) {
                if (!confirm(`Rimuovere ${nome} dalla rosa?`)) return;
                try {
                    const data = await apiFetch(`/area-riservata/api/squadre/${currentData.info.idSquadra}/giocatori/${idGiocatore}`, { method: 'DELETE' });
                    renderSquadra(data);
                } catch (err) {
                    errorEl.textContent = err.message;
                    errorEl.classList.remove('d-none');
                }
            }

            // --- Personalizzazione divisa squadra (fase 6): pulsante nel box "Squadra"
            // (dentro #squadraContent, riagganciato ad ogni renderSquadra), modale e sua
            // interazione interna (agganciate una sola volta, come per #modificaGiocatoreModal). ---
            function wireDivisaButton() {
                const btn = contentEl.querySelector('.cms-personalizza-divisa');
                if (btn) btn.addEventListener('click', apriModaleDivisa);
            }

            function mostraStepDivisa(n) {
                divisaStepCorrente = n;
                [1, 2, 3].forEach(i => {
                    document.getElementById(`divisaStep${i}`).classList.toggle('d-none', i !== n);
                });
                divisaModalEl.querySelectorAll('#divisaStepNav [data-step]').forEach(btn => {
                    btn.classList.toggle('active', Number(btn.dataset.step) === n);
                });
                document.getElementById('divisaIndietro').disabled = n === 1;
                document.getElementById('divisaAvanti').classList.toggle('d-none', n === 3);
                document.getElementById('divisaSalva').classList.toggle('d-none', n !== 3);
            }

            function renderGalleriaDivisa() {
                const galleriaEl = document.getElementById('divisaGalleria');
                galleriaEl.innerHTML = divisaCatalogo.map(t => `
                    <div class="col">
                        <button type="button" class="btn btn-outline-secondary p-1 w-100 divisa-template-thumb ${t.id === divisaTemplateSelezionatoId ? 'btn-secondary active' : ''}"
                                data-id="${t.id}" title="${t.nome}">
                            <img src="${DIVISA_BASE_URL_TEMPLATE}/${t.cartellaAsset}/icona.png" class="img-fluid" alt="${t.nome}">
                        </button>
                    </div>`).join('');

                galleriaEl.querySelectorAll('.divisa-template-thumb').forEach(btn => {
                    btn.addEventListener('click', () => {
                        divisaTemplateSelezionatoId = Number(btn.dataset.id);
                        galleriaEl.querySelectorAll('.divisa-template-thumb').forEach(b => b.classList.remove('btn-secondary', 'active'));
                        btn.classList.add('btn-secondary', 'active');
                        aggiornaVisibilitaPaletteDivisa().then(aggiornaAnteprimaDivisa);
                    });
                });
            }

            // Migliorie lettering sponsor (fase 8.4). Nessun elenco di posizioni/font
            // duplicato qui: il gruppo di pulsanti e la <select> si popolano leggendo
            // le chiavi direttamente da DivisaRenderEngine.POSIZIONI_TESTO_SPONSOR e
            // window.DivisaFonts.MANIFESTO (uniche fonti di verità, già usate anche
            // dalla pagina di validazione /dev/divisa-engine della fase 8.3) — statici,
            // renderizzati una sola volta e non ad ogni apertura della modale.
            function renderPosizioniSponsor() {
                const groupEl = document.getElementById('divisaPosizioneSponsorGroup');
                const chiavi = Object.keys(DivisaRenderEngine.POSIZIONI_TESTO_SPONSOR);
                groupEl.innerHTML = chiavi.map(chiave => `
                    <button type="button" class="btn btn-outline-secondary btn-sm divisa-posizione-sponsor-btn" data-posizione="${chiave}">${chiave}</button>`).join('');

                groupEl.querySelectorAll('.divisa-posizione-sponsor-btn').forEach(btn => {
                    btn.addEventListener('click', () => impostaPosizioneSponsor(btn.dataset.posizione, { aggiorna: true }));
                });
                impostaPosizioneSponsor(divisaPosizioneSponsorSelezionata, { aggiorna: false });
            }

            function impostaPosizioneSponsor(chiave, { aggiorna }) {
                divisaPosizioneSponsorSelezionata = chiave;
                document.querySelectorAll('.divisa-posizione-sponsor-btn').forEach(b => {
                    b.classList.toggle('btn-secondary', b.dataset.posizione === chiave);
                    b.classList.toggle('active', b.dataset.posizione === chiave);
                });
                if (aggiorna) aggiornaAnteprimaDivisa();
            }

            function renderFontSponsor() {
                const selectEl = document.getElementById('divisaFontTestoSponsor');
                const chiavi = ['Predefinito'].concat(Object.keys(DivisaFonts.MANIFESTO));
                selectEl.innerHTML = chiavi.map(chiave => `<option value="${chiave}">${chiave}</option>`).join('');
            }

            function aggiornaStatoDimensioneSponsor() {
                document.getElementById('divisaDimensioneTestoSponsor').disabled = document.getElementById('divisaAutoFitTestoSponsor').checked;
            }

            // Fase 10 — mostra/nasconde i color picker Colore2/Colore3 in base a
            // quali canali sono realmente presenti nel base.png del template
            // selezionato (vedi DivisaRenderEngine.analizzaPaletteDisponibili,
            // stessa logica già applicata alla pagina di validazione tecnica
            // /dev/divisa-engine). Chiamata solo quando cambia il template.
            async function aggiornaVisibilitaPaletteDivisa() {
                const template = divisaCatalogo.find(t => t.id === divisaTemplateSelezionatoId);
                const colore2WrapperEl = document.getElementById('divisaColore2Wrapper');
                const colore3WrapperEl = document.getElementById('divisaColore3Wrapper');
                const notaEl = document.getElementById('divisaPaletteNonDisponibiliNota');
                if (!template || typeof DivisaRenderEngine.analizzaPaletteDisponibili !== 'function') {
                    return;
                }
                try {
                    const palette = await DivisaRenderEngine.analizzaPaletteDisponibili(template.cartellaAsset, DIVISA_BASE_URL_TEMPLATE);
                    if (colore2WrapperEl) colore2WrapperEl.hidden = !palette.colore2;
                    if (colore3WrapperEl) colore3WrapperEl.hidden = !palette.colore3;
                    if (notaEl) notaEl.hidden = !!(palette.colore2 && palette.colore3);
                } catch (err) {
                    // Se l'analisi fallisce mostriamo comunque tutti e 3 i color
                    // picker: aggiornaAnteprimaDivisa riporterà l'errore vero e
                    // proprio nel riquadro dedicato.
                }
            }

            async function aggiornaAnteprimaDivisa() {
                const template = divisaCatalogo.find(t => t.id === divisaTemplateSelezionatoId);
                const erroreMotoreEl = document.getElementById('divisaErroreMotore');
                if (!template) return;

                erroreMotoreEl.classList.add('d-none');
                try {
                    await DivisaRenderEngine.componiMaglia(document.getElementById('divisaAnteprimaCanvas'), {
                        cartellaAssetTemplate: template.cartellaAsset,
                        baseUrlTemplate: DIVISA_BASE_URL_TEMPLATE,
                        baseUrlCondivisi: DIVISA_BASE_URL_CONDIVISI,
                        colore1: document.getElementById('divisaColore1').value,
                        colore2: document.getElementById('divisaColore2').value,
                        colore3: document.getElementById('divisaColore3').value,
                        testoSponsor: document.getElementById('divisaTestoSponsor').value,
                        coloreTestoSponsor: document.getElementById('divisaColoreTestoSponsor').value,
                        coloreContornoTestoSponsor: document.getElementById('divisaUsaContornoSponsor').checked ? document.getElementById('divisaColoreContornoTestoSponsor').value : null,
                        coloreSfondoTestoSponsor: document.getElementById('divisaUsaSfondoSponsor').checked ? document.getElementById('divisaColoreSfondoTestoSponsor').value : null,
                        posizioneTestoSponsor: divisaPosizioneSponsorSelezionata,
                        fontTestoSponsor: document.getElementById('divisaFontTestoSponsor').value,
                        coloreOmbraTestoSponsor: document.getElementById('divisaUsaOmbraSponsor').checked ? document.getElementById('divisaColoreOmbraTestoSponsor').value : null,
                        dimensioneTestoSponsor: Number(document.getElementById('divisaDimensioneTestoSponsor').value),
                        autoFitTestoSponsor: document.getElementById('divisaAutoFitTestoSponsor').checked,
                        letteringAdArcoTestoSponsor: document.getElementById('divisaLetteringAdArcoTestoSponsor').checked
                    });
                } catch (err) {
                    erroreMotoreEl.textContent = `Errore nella composizione: ${err.message}`;
                    erroreMotoreEl.classList.remove('d-none');
                }
            }

            async function apriModaleDivisa() {
                document.getElementById('divisaCaricamento').classList.remove('d-none');
                document.getElementById('divisaErrore').classList.add('d-none');
                document.getElementById('divisaContenuto').classList.add('d-none');
                document.getElementById('divisaErroreSalvataggio').classList.add('d-none');
                divisaModal.show();

                try {
                    const dati = await apiFetch(`/area-riservata/api/squadre/${currentData.info.idSquadra}/divisa`);
                    divisaCatalogo = dati.catalogoTemplate;
                    divisaTemplateSelezionatoId = dati.divisa.idTemplate;

                    document.getElementById('divisaColore1').value = dati.divisa.colore1;
                    document.getElementById('divisaColore2').value = dati.divisa.colore2;
                    document.getElementById('divisaColore3').value = dati.divisa.colore3;
                    document.getElementById('divisaTestoSponsor').value = dati.divisa.testoSponsor ?? '';
                    document.getElementById('divisaColoreTestoSponsor').value = dati.divisa.coloreTestoSponsor ?? '#FFFFFF';
                    document.getElementById('divisaColoreContornoTestoSponsor').value = dati.divisa.coloreContornoTestoSponsor ?? '#000000';
                    document.getElementById('divisaColoreSfondoTestoSponsor').value = dati.divisa.coloreSfondoTestoSponsor ?? '#000000';
                    document.getElementById('divisaUsaContornoSponsor').checked = !!dati.divisa.coloreContornoTestoSponsor;
                    document.getElementById('divisaUsaSfondoSponsor').checked = !!dati.divisa.coloreSfondoTestoSponsor;

                    impostaPosizioneSponsor(dati.divisa.posizioneTestoSponsor ?? 'Alto', { aggiorna: false });
                    document.getElementById('divisaFontTestoSponsor').value = dati.divisa.fontTestoSponsor ?? 'Predefinito';
                    document.getElementById('divisaColoreOmbraTestoSponsor').value = dati.divisa.coloreOmbraTestoSponsor ?? '#000000';
                    document.getElementById('divisaUsaOmbraSponsor').checked = !!dati.divisa.coloreOmbraTestoSponsor;
                    document.getElementById('divisaDimensioneTestoSponsor').value = dati.divisa.dimensioneTestoSponsor ?? 100;
                    document.getElementById('divisaDimensioneTestoSponsorValore').textContent = dati.divisa.dimensioneTestoSponsor ?? 100;
                    document.getElementById('divisaAutoFitTestoSponsor').checked = !!dati.divisa.autoFitTestoSponsor;
                    document.getElementById('divisaLetteringAdArcoTestoSponsor').checked = !!dati.divisa.letteringAdArcoTestoSponsor;
                    aggiornaStatoDimensioneSponsor();

                    renderGalleriaDivisa();
                    mostraStepDivisa(1);
                    await aggiornaVisibilitaPaletteDivisa();
                    await aggiornaAnteprimaDivisa();

                    document.getElementById('divisaCaricamento').classList.add('d-none');
                    document.getElementById('divisaContenuto').classList.remove('d-none');
                } catch (err) {
                    document.getElementById('divisaCaricamento').classList.add('d-none');
                    const erroreEl = document.getElementById('divisaErrore');
                    erroreEl.textContent = err.message;
                    erroreEl.classList.remove('d-none');
                }
            }

            divisaModalEl.querySelector('#divisaStepNav').addEventListener('click', (e) => {
                const btn = e.target.closest('[data-step]');
                if (btn) mostraStepDivisa(Number(btn.dataset.step));
            });
            document.getElementById('divisaAvanti').addEventListener('click', () => mostraStepDivisa(Math.min(3, divisaStepCorrente + 1)));
            document.getElementById('divisaIndietro').addEventListener('click', () => mostraStepDivisa(Math.max(1, divisaStepCorrente - 1)));

            // Gruppo posizione e select font sono statici (le chiavi non cambiano da
            // squadra a squadra): renderizzati una sola volta qui, non ad ogni apertura
            // della modale — apriModaleDivisa si limita a impostarne il valore corrente.
            renderPosizioniSponsor();
            renderFontSponsor();

            [
                'divisaColore1', 'divisaColore2', 'divisaColore3',
                'divisaTestoSponsor', 'divisaColoreTestoSponsor', 'divisaColoreContornoTestoSponsor', 'divisaColoreSfondoTestoSponsor',
                'divisaUsaContornoSponsor', 'divisaUsaSfondoSponsor',
                'divisaFontTestoSponsor', 'divisaColoreOmbraTestoSponsor', 'divisaUsaOmbraSponsor',
                'divisaDimensioneTestoSponsor', 'divisaAutoFitTestoSponsor', 'divisaLetteringAdArcoTestoSponsor'
            ].forEach(id => document.getElementById(id).addEventListener('input', (e) => {
                if (id === 'divisaDimensioneTestoSponsor') {
                    document.getElementById('divisaDimensioneTestoSponsorValore').textContent = e.target.value;
                }
                if (id === 'divisaAutoFitTestoSponsor') {
                    aggiornaStatoDimensioneSponsor();
                }
                aggiornaAnteprimaDivisa();
            }));

            document.getElementById('divisaSalva').addEventListener('click', async () => {
                const erroreEl = document.getElementById('divisaErroreSalvataggio');
                erroreEl.classList.add('d-none');

                if (!divisaTemplateSelezionatoId) {
                    erroreEl.textContent = 'Seleziona un template dal passo 1.';
                    erroreEl.classList.remove('d-none');
                    return;
                }

                const payload = {
                    idTemplate: divisaTemplateSelezionatoId,
                    colore1: document.getElementById('divisaColore1').value,
                    colore2: document.getElementById('divisaColore2').value,
                    colore3: document.getElementById('divisaColore3').value,
                    testoSponsor: document.getElementById('divisaTestoSponsor').value || null,
                    coloreTestoSponsor: document.getElementById('divisaColoreTestoSponsor').value,
                    coloreContornoTestoSponsor: document.getElementById('divisaUsaContornoSponsor').checked ? document.getElementById('divisaColoreContornoTestoSponsor').value : null,
                    coloreSfondoTestoSponsor: document.getElementById('divisaUsaSfondoSponsor').checked ? document.getElementById('divisaColoreSfondoTestoSponsor').value : null,
                    posizioneTestoSponsor: divisaPosizioneSponsorSelezionata,
                    fontTestoSponsor: document.getElementById('divisaFontTestoSponsor').value,
                    coloreOmbraTestoSponsor: document.getElementById('divisaUsaOmbraSponsor').checked ? document.getElementById('divisaColoreOmbraTestoSponsor').value : null,
                    dimensioneTestoSponsor: Number(document.getElementById('divisaDimensioneTestoSponsor').value),
                    autoFitTestoSponsor: document.getElementById('divisaAutoFitTestoSponsor').checked,
                    letteringAdArcoTestoSponsor: document.getElementById('divisaLetteringAdArcoTestoSponsor').checked,
                    // PNG "cotto" dal motore di rendering (fase 4) sull'anteprima corrente —
                    // il salvataggio fisico e l'URL finale sono responsabilità del server
                    // (IFileStorageProvider, vedi fase 5), non di questo JS.
                    immagineGenerataBase64: document.getElementById('divisaAnteprimaCanvas').toDataURL('image/png')
                };

                try {
                    await apiFetch(`/area-riservata/api/squadre/${currentData.info.idSquadra}/divisa`, {
                        method: 'PUT',
                        body: JSON.stringify(payload)
                    });
                    divisaModal.hide();
                } catch (err) {
                    erroreEl.textContent = err.message;
                    erroreEl.classList.remove('d-none');
                }
            });

            // Primo rendering: dati già presenti dal caricamento server-side iniziale,
            // nessuna fetch necessaria al caricamento della pagina.
            renderSquadra(currentData);
        })();
    </script>
}
