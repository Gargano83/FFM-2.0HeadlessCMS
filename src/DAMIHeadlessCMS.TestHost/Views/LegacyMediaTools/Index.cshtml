@model DAMIHeadlessCMS.TestHost.PublicSite.LegacyMediaMigrationResult?
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="utf-8" />
    <title>Migrazione media legacy — DAMIHeadlessCMS</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="container py-5" style="max-width:800px;">
        <h1 class="h3 mb-1">Migrazione loghi squadra dal sito legacy</h1>
        <p class="text-body-secondary">
            Scarica i loghi attualmente referenziati tramite <code>PublicSite:LegacyFileBaseUrl</code>
            (<code>FFM.Squadre.LogoStatistiche</code>) e li salva nello storage locale di questo host,
            aggiornando la colonna con il nuovo percorso. Operazione idempotente: le squadre già
            migrate in una passata precedente vengono saltate, non riscaricate — puoi rilanciarla in
            sicurezza dopo aver corretto eventuali errori (es. url non raggiungibile).
        </p>

        <form method="post" asp-controller="LegacyMediaTools" asp-action="MigraLoghiSquadre" class="mb-4">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-cloud-download"></i> Avvia migrazione loghi squadra
            </button>
        </form>

        @if (Model is not null)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h2 class="h5 mb-3">Risultato</h2>
                    <ul class="list-unstyled mb-3">
                        <li>✅ Migrati ora: <strong>@Model.Migrati</strong></li>
                        <li>⏭️ Già migrati in precedenza (saltati): <strong>@Model.GiaMigrati</strong></li>
                        <li>⚪ Senza logo configurato: <strong>@Model.SenzaLogo</strong></li>
                        <li>⚠️ Saltati (da rivedere manualmente): <strong>@Model.Saltati.Count</strong></li>
                        <li>❌ Falliti: <strong>@Model.Falliti.Count</strong></li>
                    </ul>

                    @if (Model.Saltati.Count > 0)
                    {
                        <div class="alert alert-warning">
                            <strong>Saltati:</strong>
                            <ul class="mb-0">
                                @foreach (var msg in Model.Saltati)
                                {
                                    <li>@msg</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.Falliti.Count > 0)
                    {
                        <div class="alert alert-danger">
                            <strong>Falliti:</strong>
                            <ul class="mb-0">
                                @foreach (var msg in Model.Falliti)
                                {
                                    <li>@msg</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.Falliti.Count == 0 && Model.Saltati.Count == 0 && Model.GiaMigrati + Model.Migrati > 0)
                    {
                        <div class="alert alert-success mb-0">
                            Tutte le squadre con un logo configurato puntano ora allo storage locale.
                            Puoi rimuovere <code>PublicSite:LegacyFileBaseUrl</code> dalla configurazione.
                        </div>
                    }
                </div>
            </div>
        }

        <p class="mt-4"><a href="/dami">&larr; Torna al backoffice</a></p>
    </div>
</body>
</html>
