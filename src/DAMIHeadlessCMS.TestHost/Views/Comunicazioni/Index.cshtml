@model DAMIHeadlessCMS.TestHost.Models.PublicSite.ComunicazioniListViewModel
@{
    ViewData["Title"] = Model.CategoriaNomeCorrente ?? "Comunicazioni";
}

<div class="container py-4 py-lg-5">
    @if (string.IsNullOrWhiteSpace(Model.IntroHtml))
    {
        <h1 class="mb-4">Comunicazioni</h1>
    }

    @if (!string.IsNullOrWhiteSpace(Model.IntroHtml))
    {
        <div class="cms-block cms-block-html mb-4">
            @Html.Raw(Model.IntroHtml)
        </div>
    }

    @if (Model.Categorie.Count > 0)
    {
        <ul class="nav nav-pills mb-4 flex-wrap">
            <li class="nav-item">
                <a class="nav-link @(Model.CategoriaSlugCorrente is null ? "active" : "")" href="/comunicazioni">
                    Tutti
                </a>
            </li>
            @foreach (var categoria in Model.Categorie)
            {
                <li class="nav-item">
                    <a class="nav-link @(string.Equals(categoria.Slug, Model.CategoriaSlugCorrente, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                       href="/comunicazioni/@categoria.Slug">
                        @categoria.Nome <span class="badge text-bg-light">@categoria.NumeroDocumenti</span>
                    </a>
                </li>
            }
        </ul>
    }

    @if (Model.Articoli.Count == 0)
    {
        <p class="text-body-secondary">Nessuna comunicazione disponibile.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var articolo in Model.Articoli)
            {
                <div class="col-12 col-md-6 comunicazioni-item">
                    @if (!string.IsNullOrWhiteSpace(articolo.NomeCategoria) || articolo.Data is not null)
                    {
                        <div class="comunicazioni-meta mb-1">
                            @if (!string.IsNullOrWhiteSpace(articolo.NomeCategoria))
                            {
                                <span>@articolo.NomeCategoria</span>
                                <span class="mx-1">&middot;</span>
                            }
                            @if (articolo.Data is not null)
                            {
                                <span>@articolo.Data.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            }
                        </div>
                    }
                    <h2 class="h5 comunicazioni-title"><a href="/comunicazioni/@articolo.Slug">@articolo.Titolo</a></h2>
                    @if (!string.IsNullOrWhiteSpace(articolo.Abstract))
                    {
                        <p class="mb-2">@articolo.Abstract</p>
                    }
                    <a href="/comunicazioni/@articolo.Slug" class="fw-semibold small">Leggi tutto</a>
                </div>
            }
        </div>

        @if (Model.TotalePagine > 1)
        {
            var basePath = Model.CategoriaSlugCorrente is null ? "/comunicazioni" : $"/comunicazioni/{Model.CategoriaSlugCorrente}";
            <nav class="mt-4" aria-label="Paginazione comunicazioni">
                <ul class="pagination">
                    <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@basePath?pagina=@(Model.Pagina - 1)">Precedente</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalePagine; p++)
                    {
                        <li class="page-item @(p == Model.Pagina ? "active" : "")">
                            <a class="page-link" href="@basePath?pagina=@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Pagina >= Model.TotalePagine ? "disabled" : "")">
                        <a class="page-link" href="@basePath?pagina=@(Model.Pagina + 1)">Successiva</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>
